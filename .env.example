ENVIRONMENT=production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_16_CHARACTERS
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_40_CHARACTERS
DATABASE_URL=sqlite:////var/lib/shaohua-license/app.db
# Optional independent subtitle database; never put production credentials here.
SUBTITLE_DATABASE_URL=
SUBTITLE_CACHE_BYTES=8589934592
SIGNING_KEY_PATH=/var/lib/shaohua-license/signing-key.pem
SUITE_APP_CODE=TK_EDITOR
SUITE_APP_NAME=TK剪辑器
LICENSE_LEASE_SECONDS=300
CLIENT_IP_REQUESTS_PER_MINUTE=1800
CLIENT_DEVICE_REQUESTS_PER_MINUTE=120
ENABLE_LEGACY_AUTH=false
ENABLE_API_DOCS=false
TZ=Asia/Shanghai
FEEDBACK_STORAGE_DIR=/var/lib/shaohua-license/feedback
FEEDBACK_MAX_ARCHIVE_BYTES=15728640
FEEDBACK_TOTAL_STORAGE_BYTES=2147483648
